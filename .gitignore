# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# env files — NEVER commit these
.env*.local
.env

# secrets — NEVER commit these
# sb-key.txt holds the Supabase service_role key. The extractor reads its key
# from C:\RetailHistory on each store server, never from this repo, so this
# file has no reason to exist here. Ignored by exact path and by bare name so
# a stray copy in another folder cannot be added either.
scripts/sb-key.txt
sb-key.txt

# client engagements — confidential, NEVER commit these
# The control is the FOLDER: engagement material lives in Daisy/Clients/ and never leaves it.
# This is the belt. Daisy's own repo ignores Clients/ but it never pushes; this repo does, so a
# stray copy here would publish a third party's data. Ignored by exact path and by bare name so
# a copy in any subfolder cannot be added either — same pattern as sb-key.txt above.
# A file copied to some other name (docs/, an export) is still committable: the folder is the rule.
/Clients
Clients/

# debug
npm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
